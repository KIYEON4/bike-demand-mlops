{
  "project_name": "bike-demand-mlops",
  "model_version": "v1.0.0",
  "dataset_path": "data/raw/day.csv",
  "split_date": "2012-08-01",
  "random_state": 42,
  "target_column": "cnt",
  "leakage_columns": [
    "casual",
    "registered"
  ],
  "id_or_date_columns": [
    "instant",
    "dteday"
  ],
  "feature_columns": [
    "season",
    "yr",
    "mnth",
    "holiday",
    "weekday",
    "workingday",
    "weathersit",
    "temp_c",
    "atemp_c",
    "hum_pct",
    "windspeed_kmh"
  ],
  "model_type": "RandomForestRegressor",
  "model_params": {
    "n_estimators": 200,
    "max_depth": 12,
    "min_samples_leaf": 2,
    "random_state": 42,
    "n_jobs": -1
  },
  "demand_thresholds": {
    "low_max": 3000,
    "high_min": 5500
  },
  "model_output_path": "models/bike_demand_v1.0.0.joblib",
  "metadata_output_path": "models/model_metadata.json"
}
